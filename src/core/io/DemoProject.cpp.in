// Made by CMake from examples/demo.tekno, as bytes: edit that file, not this one.

#include "core/io/DemoProject.h"

namespace tekno::core::io
{
juce::String demoProjectText()
{
    static const unsigned char bytes[] { @TEKNO_DEMO_BYTES@ };
    return juce::String::fromUTF8 (reinterpret_cast<const char*> (bytes), static_cast<int> (sizeof (bytes)));
}
} // namespace tekno::core::io
